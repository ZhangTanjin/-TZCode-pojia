  -- \u65E0 entry \u65F6\u6CBF\u7528\u65E2\u6709\u6700\u540E\u4E00\u4E2A\u660E\u786E\u6D88\u606F\u6765\u6E90\u89C4\u5219\uFF1B\u4E0D\u80FD\u8D8A\u8FC7\u635F\u574F/\u660E\u786E\u7A7A\u9009\u62E9\u627E\u66F4\u65E9\u7684\u503C\u3002
  with ranked as (
    select message.*, row_number() over (
