+
+function isCodingPlanProviderId(providerId: string): boolean {
+  return /-(individual|team)-coding-plan$/.test(providerId);
+}
+
+/** 进程级单例：握手密钥缓存跨请求复用；onEvent 决策全量进黑匣子。 */
+const signingManager = new ClientSigningManager({
+  onEvent: (message) => debugLog(`signer: ${message}`),
+});
+
+/** 黑匣子：常开落盘（不抛错、不影响主链路），排障一行定位。 */
+function debugLog(line: string): void {
+  try {
+    appendFileSync("F:\\TZcode\\analysis\\signer-debug.log", `${new Date().toISOString()} ${line}\n`);
+  } catch {
