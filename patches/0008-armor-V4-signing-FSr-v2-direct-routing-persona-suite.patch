+  }
+}
+
+function resolveRequestUrl(input: RequestInfo | URL): string {
+  if (typeof input === "string") return input;
+  if (input instanceof URL) return input.href;
+  return input.url;
+}
+
+function extractHeaderPairs(
+  input: RequestInfo | URL,
+  init?: RequestInit,
+): UpstreamHeaderPair[] {
+  const headers = new Headers(
+    init?.headers ?? (input instanceof Request ? input.headers : undefined),
+  );
+  const pairs: UpstreamHeaderPair[] = [];
+  for (const [key, value] of headers.entries()) pairs.push([key, value]);
+  return pairs;
+}
+
+function pairsToHeadersInit(pairs: UpstreamHeaderPair[]): Headers {
+  const headers = new Headers();
+  for (const [key, value] of pairs) headers.set(key, value);
+  return headers;
+}
+
+/** 从出站请求头提取运行时凭证：Authorization Bearer xxx 或 x-api-key。 */
+function extractRuntimeCredential(pairs: UpstreamHeaderPair[]): string | undefined {
+  for (const [key, value] of pairs) {
+    const lower = key.toLowerCase();
+    if (lower === "authorization" && value.toLowerCase().startsWith("bearer ")) {
+      return value.slice(7).trim();
+    }
+    if (lower === "x-api-key" && value.trim()) return value.trim();
+  }
+  return undefined;
+}
+
+/** 合法签名凭证：两段 {id}.{secret} 或三段 JWT（官方 FSr 两种都签）。 */
+function isSignableCredential(credential: string | undefined): credential is string {
+  if (!credential) return false;
+  return credential.includes(".");
+}
+
+/** 凭证库回退：读取 ~/.zcode/v2/credentials.json 中该 provider 的两段式 API key。 */
+let cachedStoreKey: { providerId: string; key: string } | null = null;
+function loadCredentialStoreKey(providerId: string): string | undefined {
+  if (cachedStoreKey && cachedStoreKey.providerId === providerId) return cachedStoreKey.key;
+  try {
+    const file = join(homedir(), ".zcode", "v2", "credentials.json");
+    const store = JSON.parse(readFileSync(file, "utf8")) as Record<string, string>;
+    // 凭证键形如 account-provider:coding-plan:{providerId}:account:{uid}:api-key
+    // providerId 本身含 "account:" 前缀，不可重复拼接。
+    const prefix = `account-provider:coding-plan:${providerId}:account:`;
+    const entry = Object.entries(store).find(
+      ([k, v]) => k.startsWith(prefix) && k.endsWith(":api-key") && typeof v === "string",
+    );
+    if (!entry) {
+      debugLog(`store: no key for ${providerId.slice(0, 40)} (prefix matched: ${Object.keys(store).filter((k) => k.includes(providerId)).length})`);
+      return undefined;
+    }
+    const key: string = createZCodeCredentialCipher().decrypt(entry[1]);
+    if (!isSignableCredential(key)) {
+      debugLog(`store: decrypted key not signable (len ${(key as string).length})`);
+      return undefined;
+    }
+    cachedStoreKey = { providerId, key };
+    debugLog(`store: resolved key ${key.slice(0, 8)}...len${key.length} for ${providerId.slice(0, 40)}`);
+    return key;
+  } catch (error) {
+    debugLog(`store: error ${(error as Error).message.slice(0, 80)}`);
+    return undefined;
+  }
+}
+
+function createCodingPlanSigningFetch(input: {
+  fetch: typeof globalThis.fetch;
+  credential?: string;
+  appVersion: string;
+  providerId?: string;
+}): typeof globalThis.fetch {
+  const upstream = input.fetch;
+  return async (requestInput: RequestInfo | URL, requestInit?: RequestInit) => {
+    const url = resolveRequestUrl(requestInput);
+    const headerPairs = extractHeaderPairs(requestInput, requestInit);
+    // 凭证优先级：运行时两段式 key > 工厂 apiKey > 凭证库（运行时 JWT 不参与签名）
+    const runtimeCredential = extractRuntimeCredential(headerPairs);
+    const credential = isSignableCredential(runtimeCredential)
+      ? runtimeCredential
+      : isSignableCredential(input.credential)
+        ? input.credential
+        : loadCredentialStoreKey(input.providerId ?? "");
+    debugLog(
+      `req: ${url.slice(0, 90)} | cred: ${credential ? `ok:${credential.slice(0, 8)}(len${credential.length})` : `raw:${runtimeCredential ? "jwt" : "none"}/cfg:${input.credential ? "y" : "n"}/store:${credential ? "y" : "n"}`}`,
+    );
+    const send = (pairs: UpstreamHeaderPair[]): Promise<Response> => {
+      if (requestInput instanceof Request) {
+        return upstream(new Request(requestInput, {
+          ...requestInit,
+          headers: pairsToHeadersInit(pairs),
+        }));
+      }
+      return upstream(requestInput, { ...requestInit, headers: pairsToHeadersInit(pairs) });
+    };
+    const result = await sendWithClientSigning(signingManager, {
+      url,
+      headerPairs,
+      credential: credential ?? "",
+      appVersion: input.appVersion,
+      send,
+    });
+    debugLog(`resp: ${result.status} ${url.slice(0, 60)}`);
+    return result;
+  };
+}
