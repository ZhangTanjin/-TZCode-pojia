+// ============================================================
+// Persona Source - 外置人格文件加载
+// ============================================================
+//
+// 精准 persona 模式的唯一内容入口。文件存在且非空即激活；
+// 缺失/为空自动回退原版装配，无需开关。
+//
+// 解析顺序：
+//   1. 环境变量 ZCODE_PERSONA_FILE 指定的绝对路径
+//   2. ~/.zcode/persona/persona.txt
+//
+// 每次 build() 现读：改文件即生效，与旧 cjs 补丁的热切换体验一致，
+// 一次 13KB 级 readFileSync 的开销可忽略。
+
+import { readFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { isAbsolute, resolve } from "node:path";
+
+const PERSONA_FILE_ENV = "ZCODE_PERSONA_FILE";
+const DEFAULT_PERSONA_RELATIVE_PATH = ["persona", "persona.txt"] as const;
+
+export function resolvePersonaFilePath(env: NodeJS.ProcessEnv = process.env): string {
+  const fromEnv = env[PERSONA_FILE_ENV]?.trim();
+  if (fromEnv) return isAbsolute(fromEnv) ? fromEnv : resolve(process.cwd(), fromEnv);
+  return resolve(homedir(), ".zcode", ...DEFAULT_PERSONA_RELATIVE_PATH);
+}
+
+/** 读取 persona 文件；不存在或内容为空返回 undefined（回退原版装配）。 */
+export function loadPersonaContent(env: NodeJS.ProcessEnv = process.env): string | undefined {
+  let raw: string;
+  try {
+    raw = readFileSync(resolvePersonaFilePath(env), "utf8");
+  } catch {
+    return undefined;
+  }
+  const trimmed = raw.trim();
+  return trimmed.length > 0 ? trimmed : undefined;
+}
