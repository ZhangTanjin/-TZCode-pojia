--- /dev/null
+++ b/apps/zcode-cli/packages/core/tests/persona-source.test.ts
@@ -0,0 +1,38 @@
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterAll, describe, expect, it } from "vitest";
+import {
+  loadPersonaContent,
+  resolvePersonaFilePath,
+} from "../src/context/persona-source.js";
+
+const tempDir = mkdtempSync(join(tmpdir(), "zcode-persona-"));
+afterAll(() => {
+  rmSync(tempDir, { recursive: true, force: true });
+});
+
+describe("persona-source", () => {
+  it("resolves the default path under ~/.zcode/persona", () => {
+    const resolved = resolvePersonaFilePath({});
+    expect(resolved).toContain(join(".zcode", "persona", "persona.txt"));
+  });
+
+  it("prefers ZCODE_PERSONA_FILE when set to an absolute path", () => {
+    const file = join(tempDir, "custom-persona.txt");
+    expect(resolvePersonaFilePath({ ZCODE_PERSONA_FILE: file })).toBe(file);
+  });
+
+  it("returns trimmed content for a populated persona file", () => {
+    const file = join(tempDir, "populated.txt");
+    writeFileSync(file, "  PERSONA-CONTENT \n", "utf8");
+    expect(loadPersonaContent({ ZCODE_PERSONA_FILE: file })).toBe("PERSONA-CONTENT");
+  });
+
+  it("returns undefined for missing or whitespace-only files", () => {
+    expect(loadPersonaContent({ ZCODE_PERSONA_FILE: join(tempDir, "absent.txt") })).toBeUndefined();
+    const empty = join(tempDir, "empty.txt");
+    writeFileSync(empty, "   \n", "utf8");
+    expect(loadPersonaContent({ ZCODE_PERSONA_FILE: empty })).toBeUndefined();
+  });
+});
