@@ -0,0 +1,196 @@
+/**
+ * start-plan-gate — TZCode 对 start-plan 免费车道的门禁通行器。
+ *
+ * 网关（zcode.z.ai）对 start-plan 流量设两道硬门（zcode-api 逆向成果，
+ * 对照官方 3.11.2–3.15.1 bundle 逐字验证）：
+ *   1. system 内容检查：请求 system 里看不到 ZCode 官方身份三块 →
+ *      3012 "request has been blocked due to unusual activity" / 405
+ *   2. 阿里云验证码：缺 x-aliyun-captcha-verify-param → 挑战头 / 3007
+ *
+ * 本包装器在 transport 层给 start-plan 请求补齐两道门：
+ *   - 官方三块 system 前置（cliPrefix + stable identity/desktop + dynamic
+ *     env/ctxmgmt），客户端自身 system（TZCode + persona）原样缀后，
+ *     cache_control 剥离（官方块占 3 个 ephemeral 断点 + 末条消息 1 个 =
+ *     Anthropic 4 断点上限）
+ *   - currentDate context_prefix（system-reminder user 轮）前置 —— 官方
+ *     客户端每请求必带
+ *   - 验证码令牌随请求附带；被挑战时换新票重试一次
+ *
+ * coding-plan / off-peak / highspeed 车道不经此门（签名 V4 只覆盖
+ * coding-plan 且服务端 fail-open，无需实现）。
+ */
+import { arch, platform as nodePlatform, release } from "node:os";
+import {
+  buildContextPrefixMessage,
+  buildStartPlanSystem,
+  type StartPlanEnvInfo,
+} from "./system-prompt.js";
+import {
+  detectCaptchaChallenge,
+  getCaptchaToken,
+  RETRY_HEADERS,
+  startCaptchaPool,
+  urgentCaptcha,
+} from "./captcha.js";
+
+const DEFAULT_APP_VERSION = "3.14.5";
+const CAPTCHA_TOKEN_TIMEOUT_MS = Number(process.env.ZCODE_CAPTCHA_TIMEOUT_MS || 30_000);
+const OFFICIAL_CLI_PREFIX_MARKER = "You are ZCode, an interactive coding agent";
+
+export function isStartPlanProviderId(providerId: string): boolean {
+  return /-(start-plan)$/.test(providerId);
+}
+
+/** 与 X-Platform / X-Os-Version 请求头同源的运行时值——网关校验一致性。 */
+export function resolveGateEnvInfo(): StartPlanEnvInfo {
+  return {
+    cwd: process.env.ZCODE_GATE_CWD || process.cwd(),
+    platform: nodePlatform(),
+    shell: process.env.ZCODE_GATE_SHELL || (nodePlatform() === "win32" ? "system shell" : "bash"),
+    osVersion: `${nodePlatform()} ${release()} ${arch() === "x64" ? "x64" : arch()}`,
+  };
+}
+
+function withTimeout<T>(promise: Promise<T>, ms: number, label: string): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error(`${label} timeout`)), ms);
+    promise.then(
+      (value) => {
+        clearTimeout(timer);
+        resolve(value);
+      },
+      (error) => {
+        clearTimeout(timer);
+        reject(error);
+      },
+    );
+  });
+}
+
+async function readBodyText(input: RequestInfo | URL, init?: RequestInit): Promise<string | undefined> {
+  if (typeof init?.body === "string") return init.body;
+  if (init?.body instanceof Uint8Array) return new TextDecoder().decode(init.body);
+  if (init?.body != null) return undefined; // 未知形态原样放行
+  if (input instanceof Request) return input.clone().text();
+  return undefined;
+}
+
+let poolStarted = false;
+
+async function ensurePoolStarted(appVersion: string): Promise<void> {
+  if (poolStarted) return;
+  poolStarted = true;
+  // 后台预热；失败不阻塞（按需求解兜底）
+  void startCaptchaPool(appVersion).catch(() => {});
+}
+
+async function mintCaptchaHeaders(
+  appVersion: string,
+): Promise<Record<string, string> | undefined> {
+  try {
+    const token = await withTimeout(getCaptchaToken(appVersion), CAPTCHA_TOKEN_TIMEOUT_MS, "captcha");
+    return {
+      [RETRY_HEADERS.PARAM]: token.verifyParam,
+      [RETRY_HEADERS.REGION]: token.region,
+    };
+  } catch {
+    return undefined; // fail-open：无票也发，挑战重试路径兜底
+  }
+}
+
+/** 响应是否为 3007 验证码拒绝（读 clone，不消费原 body）。 */
+async function isCaptchaRejected(resp: Response): Promise<boolean> {
+  if (resp.status !== 400) return false;
+  try {
+    const body = (await resp.clone().json()) as { code?: number | string };
+    return Number(body?.code) === 3007;
+  } catch {
+    return false;
+  }
+}
+
+export function createStartPlanGateFetch(input: {
+  fetch: typeof globalThis.fetch;
+  appVersion?: string;
+  provider?: "bigmodel" | "zai";
+}): typeof globalThis.fetch {
+  const upstream = input.fetch;
+  const provider = input.provider ?? "bigmodel";
+  const appVersion = input.appVersion || process.env.ZCODE_APP_VERSION || DEFAULT_APP_VERSION;
+  void ensurePoolStarted(appVersion);
+
+  return async (requestInput: RequestInfo | URL, requestInit?: RequestInit) => {
+    // 请求级开关：ZCODE_START_PLAN_GATE=0 完全旁路（测试/应急用）
+    if (process.env.ZCODE_START_PLAN_GATE === "0") {
+      return upstream(requestInput, requestInit);
+    }
+    const bodyText = await readBodyText(requestInput, requestInit);
+    if (bodyText === undefined) {
+      return upstream(requestInput, requestInit);
+    }
+
+    let body: Record<string, unknown>;
+    try {
+      body = JSON.parse(bodyText) as Record<string, unknown>;
+    } catch {
+      return upstream(requestInput, requestInit);
+    }
+
+    // ── 门 1：官方 system 三块迷彩（幂等：已带官方前缀则跳过） ──
+    const system = body.system as unknown;
+    const firstBlock = Array.isArray(system)
+      ? (system[0] as { text?: unknown } | undefined)
+      : undefined;
+    const alreadyCamouflaged =
+      typeof firstBlock?.text === "string" &&
+      (firstBlock.text as string).startsWith(OFFICIAL_CLI_PREFIX_MARKER);
+    if (!alreadyCamouflaged) {
+      const model = typeof body.model === "string" ? body.model : undefined;
+      body.system = buildStartPlanSystem(body.system, model, resolveGateEnvInfo(), provider);
+      if (Array.isArray(body.messages) && body.messages.length > 0) {
+        body.messages = [buildContextPrefixMessage() as unknown, ...body.messages];
+      }
+      if (Array.isArray(body.tools)) {
+        for (const tool of body.tools) {
+          if (tool && typeof tool === "object" && "cache_control" in tool) {
+            delete (tool as Record<string, unknown>).cache_control;
+          }
+        }
+      }
+    }
+
+    const patchedBody = JSON.stringify(body);
+    const baseHeaders = new Headers(
+      requestInit?.headers ?? (requestInput instanceof Request ? requestInput.headers : undefined),
+    );
+
+    const dispatch = (headers: Headers): Promise<Response> => {
+      if (requestInput instanceof Request) {
+        return upstream(new Request(requestInput, { ...requestInit, body: patchedBody, headers }));
+      }
+      return upstream(requestInput, { ...requestInit, body: patchedBody, headers });
+    };
+
+    // ── 门 2：验证码令牌 ──
+    const captchaHeaders = await mintCaptchaHeaders(appVersion);
+    const sendHeaders = new Headers(baseHeaders);
+    if (captchaHeaders) {
+      for (const [key, value] of Object.entries(captchaHeaders)) sendHeaders.set(key, value);
+    }
+    let response = await dispatch(sendHeaders);
+
+    // 挑战重试（一次）：挑战头命中或 400/3007
+    const challenged =
+      detectCaptchaChallenge(response) !== null || (await isCaptchaRejected(response));
+    if (challenged) {
+      urgentCaptcha();
+      const retryHeaders = await mintCaptchaHeaders(appVersion);
+      if (retryHeaders) {
+        const next = new Headers(baseHeaders);
+        for (const [key, value] of Object.entries(retryHeaders)) next.set(key, value);
+        response = await dispatch(next);
+      }
+    }
+    return response;
+  };
+}
