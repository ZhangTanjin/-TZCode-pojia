+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("../src/model/start-plan-gate/captcha.js", () => ({
+  RETRY_HEADERS: {
+    PARAM: "x-aliyun-captcha-verify-param",
+    REGION: "x-aliyun-captcha-verify-region",
+  },
+  getCaptchaToken: vi.fn(async () => ({ verifyParam: "token-1", region: "cn-hangzhou" })),
+  detectCaptchaChallenge: vi.fn((resp: Response) => resp.headers.get("x-aliyun-captcha-verify-param")),
+  startCaptchaPool: vi.fn(async () => {}),
+  urgentCaptcha: vi.fn(),
+}));
+
+import {
+  createStartPlanGateFetch,
+  isStartPlanProviderId,
+} from "../src/model/start-plan-gate/index.js";
+
+const OFFICIAL_PREFIX = "You are ZCode, an interactive coding agent";
+
+interface CapturedRequest {
+  url: string;
+  headers: Headers;
+  body: Record<string, unknown>;
+}
+
+function makeCaptureDispatch(responses: Response[]) {
+  const captured: CapturedRequest[] = [];
+  const fetch = async (input: RequestInfo | URL, init?: RequestInit) => {
+    const url = typeof input === "string" ? input : input.toString();
+    const headers = new Headers(init?.headers);
+    let body: Record<string, unknown> | string;
+    try {
+      body = JSON.parse(String(init?.body ?? "{}")) as Record<string, unknown>;
+    } catch {
+      body = String(init?.body ?? "");
+    }
+    captured.push({ url, headers, body });
+    const resp = responses[Math.min(captured.length - 1, responses.length - 1)]!;
+    return resp;
+  };
+  return { captured, fetch };
+}
+
+function anthropicBody(overrides: Record<string, unknown> = {}) {
+  return JSON.stringify({
+    model: "GLM-5.3-Flash",
+    max_tokens: 128,
+    stream: true,
+    system: [{ type: "text", text: "You are TZCode, an interactive coding agent" }],
+    messages: [{ role: "user", content: [{ type: "text", text: "你好" }] }],
+    ...overrides,
+  });
+}
+
+describe("start-plan-gate", () => {
+  beforeEach(() => {
+    process.env.ZCODE_START_PLAN_GATE = "1";
+  });
+  afterEach(() => {
+    delete process.env.ZCODE_START_PLAN_GATE;
+    vi.clearAllMocks();
+  });
+
+  it("matches only start-plan provider ids", () => {
+    expect(isStartPlanProviderId("account:bigmodel-start-plan")).toBe(true);
+    expect(isStartPlanProviderId("account:zai-start-plan")).toBe(true);
+    expect(isStartPlanProviderId("account:bigmodel-individual-coding-plan")).toBe(false);
+    expect(isStartPlanProviderId("api-anthropic")).toBe(false);
+  });
+
+  it("prepends official system blocks and context prefix, keeps client system after", async () => {
+    const { captured, fetch } = makeCaptureDispatch([new Response("{}", { status: 200 })]);
+    const gate = createStartPlanGateFetch({ fetch });
+    const resp = await gate("https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages", {
+      method: "POST",
+      body: anthropicBody(),
+      headers: { "content-type": "application/json" },
+    });
+    expect(resp.status).toBe(200);
+    expect(captured).toHaveLength(1);
+
+    const system = captured[0]!.body.system as { text: string; cache_control?: unknown }[];
+    expect(system.length).toBe(4);
+    expect(system[0]!.text.startsWith(OFFICIAL_PREFIX)).toBe(true);
+    expect(system[0]!.cache_control).toEqual({ type: "ephemeral" });
+    // 客户端 system 原样缀后且 cache_control 被剥离
+    expect(system[3]!.text).toBe("You are TZCode, an interactive coding agent");
+    expect(system[3]!.cache_control).toBeUndefined();
+
+    const messages = captured[0]!.body.messages as { role: string; content: { text: string }[] }[];
+    expect(messages[0]!.role).toBe("user");
+    expect(messages[0]!.content[0]!.text).toContain("<system-reminder>");
+    expect(messages[0]!.content[0]!.text).toContain("# currentDate");
+    expect(messages[1]!.content[0]!.text).toBe("你好");
+
+    expect(captured[0]!.headers.get("x-aliyun-captcha-verify-param")).toBe("token-1");
+    expect(captured[0]!.headers.get("x-aliyun-captcha-verify-region")).toBe("cn-hangzhou");
+  });
+
+  it("is idempotent: an already-camouflaged system is not double-wrapped", async () => {
+    const { captured, fetch } = makeCaptureDispatch([new Response("{}", { status: 200 })]);
+    const gate = createStartPlanGateFetch({ fetch });
+    await gate("https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages", {
+      method: "POST",
+      body: anthropicBody({
+        system: [{ type: "text", text: `${OFFICIAL_PREFIX}` }],
+      }),
+    });
+    const system = captured[0]!.body.system as { text: string }[];
+    expect(system.length).toBe(1);
+    const messages = captured[0]!.body.messages as unknown[];
+    expect(messages.length).toBe(1); // 无 context-prefix 追加
+  });
+
+  it("bypasses entirely when ZCODE_START_PLAN_GATE=0", async () => {
+    process.env.ZCODE_START_PLAN_GATE = "0";
+    const { captured, fetch } = makeCaptureDispatch([new Response("{}", { status: 200 })]);
+    const gate = createStartPlanGateFetch({ fetch });
+    const body = anthropicBody();
+    await gate("https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages", {
+      method: "POST",
+      body,
+      headers: { "content-type": "application/json" },
+    });
+    expect(captured[0]!.body).toEqual(JSON.parse(body));
+    expect(captured[0]!.headers.get("x-aliyun-captcha-verify-param")).toBeNull();
+  });
+
+  it("retries once with a fresh token on a 3007 captcha rejection", async () => {
+    const { getCaptchaToken } = await import("../src/model/start-plan-gate/captcha.js");
+    const mockToken = vi.mocked(getCaptchaToken);
+    mockToken
+      .mockResolvedValueOnce({ verifyParam: "spent-token", region: "cn-hangzhou" })
+      .mockResolvedValueOnce({ verifyParam: "fresh-token", region: "cn-hangzhou" });
+
+    const { captured, fetch } = makeCaptureDispatch([
+      new Response(JSON.stringify({ code: 3007, msg: "captcha verify failed" }), { status: 400 }),
+      new Response("{}", { status: 200 }),
+    ]);
+    const gate = createStartPlanGateFetch({ fetch });
+    const resp = await gate("https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages", {
+      method: "POST",
+      body: anthropicBody(),
+    });
+    expect(resp.status).toBe(200);
+    expect(captured).toHaveLength(2);
+    expect(captured[0]!.headers.get("x-aliyun-captcha-verify-param")).toBe("spent-token");
+    expect(captured[1]!.headers.get("x-aliyun-captcha-verify-param")).toBe("fresh-token");
+  });
+
+  it("passes non-JSON bodies through untouched", async () => {
+    const { captured, fetch } = makeCaptureDispatch([new Response("{}", { status: 200 })]);
+    const gate = createStartPlanGateFetch({ fetch });
+    await gate("https://zcode.z.ai/api/v1/zcode-plan/anthropic/v1/messages", {
+      method: "POST",
+      body: "not-json",
+    });
+    expect(captured[0]!.body).toBe("not-json");
+  });
+});
